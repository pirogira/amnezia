# Локальная разработка (npm run dev). Для сервера используйте install/install.sh — он создаст infra/.env

PANEL_JWT_SECRET=replace-with-long-random
PANEL_ENCRYPTION_KEY=replace-with-32plus-chars-or-openssl-rand-hex-32
PANEL_BOOTSTRAP_USERNAME=admin
PANEL_BOOTSTRAP_PASSWORD=change-me-on-first-boot
# Путь от корня репозитория (не от apps/api)
PANEL_DATABASE_PATH=data/panel.sqlite
# Если сменили пароль в .env, а админ уже был создан — один раз true, перезапуск, вход, затем удалите строку:
# PANEL_BOOTSTRAP_UPDATE_PASSWORD=true
# Показать пароль на экране входа только в dev (никогда в production):
# PANEL_SHOW_LOGIN_PASSWORD=true
PANEL_API_PORT=3001
# Через запятую, если несколько dev-URL; для Vite strictPort:5173 хватит первого
PANEL_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false
ALLOW_REGISTER=false

# Docker Compose (см. infra/docker-compose.yml) — задаёт install/install.sh
# PANEL_PUBLIC_ADDR=0.0.0.0
# PANEL_PUBLIC_PORT=8080
# PANEL_CADDY_TARGET=80
